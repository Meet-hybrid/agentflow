# AgentFlow configuration (copy to .env; never commit .env)

# API
PORT=8787
HOST=127.0.0.1
DATABASE_URL=postgres://agentflow:agentflow-dev@127.0.0.1:55432/agentflow
WEB_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=info

# Stellar (testnet)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# From scripts/deploy-testnet.sh / deployments/testnet.json:
ESCROW_CONTRACT_ID=
ARBITER_ADDRESS=
ASSETS=[{"code":"XLM","contractId":"<native XLM SAC id>","decimals":7}]

# SEP-10 signing key (auth challenges only; holds no funds).
# Preferred: a Stellar CLI identity in the OS keyring.
SEP10_SERVER_SECRET_STELLAR_KEY=agentflow-sep10
SEP10_HOME_DOMAIN=localhost

# Web app (Vite)
VITE_API_URL=http://127.0.0.1:8787

# Reference agent
AGENTFLOW_API_URL=http://127.0.0.1:8787
AGENTFLOW_AGENT_KEY=
AGENT_PAYOUT_SECRET_STELLAR_KEY=
AGENT_MIN_REWARD=1
AGENT_POLL_SECONDS=15
